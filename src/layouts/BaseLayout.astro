---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import LanguagePicker from '../components/LanguagePicker.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import profileSrc from '../assets/profile.jpg';

interface Props {
  title?: string;
  lang: Lang;
  currentPath?: string;
  ogImage?: string;
  ogDescription?: string;
  ogType?: string;
  /** Language-switcher target. Pages whose counterpart lives at a different slug
   *  (blog posts) pass an explicit path; everything else swaps the /ja prefix. */
  altPath?: string;
  /** False when no equivalent page exists in the other locale, which suppresses
   *  the hreflang alternates — they must point at a real translation. */
  hasTranslation?: boolean;
  /** ISO date for `article:published_time`; only meaningful when ogType is 'article'. */
  publishedTime?: string;
}

const {
  title = 'Daisuke Nishihama | 西濱大将',
  lang,
  currentPath = '/',
  ogImage,
  ogDescription,
  ogType = 'website',
  altPath,
  hasTranslation = true,
  publishedTime,
} = Astro.props;
const ogLocale = lang === 'ja' ? 'ja_JP' : 'en_US';
const ogLocaleAlt = lang === 'ja' ? 'en_US' : 'ja_JP';
// Derived from `site` in astro.config.mjs so the domain lives in exactly one place.
const siteUrl = Astro.site.href.replace(/\/$/, '');
// Default OGP image is derived from the same source as the avatar, so there is no
// unoptimized copy sitting in public/. Pages that pass `ogImage` use the 1200x630
// satori-generated card from /og/[slug].png instead.
// 1000px matches the source crop — asking for more would only upscale it.
const ogFallback = await getImage({
  src: profileSrc,
  width: 1000,
  height: 1000,
  format: 'jpeg',
  quality: 80,
});
const resolvedOgImage = ogImage ?? `${siteUrl}${ogFallback.src}`;
// The fallback is square; the satori cards are 1200x630. Declare what is actually there.
const ogImageWidth = ogImage ? 1200 : 1000;
const ogImageHeight = ogImage ? 630 : 1000;
const t = useTranslations(lang);

const homePath = lang === 'en' ? '/' : '/ja/';
const achievementsPath = lang === 'en' ? '/achievements/' : '/ja/achievements/';
const blogPath = lang === 'en' ? '/blog/' : '/ja/blog/';
const web3Path = lang === 'en' ? '/web3/' : '/ja/web3/';

const canonicalUrl = `${siteUrl}${currentPath}`;
const enPath = lang === 'ja'
  ? (currentPath === '/ja/' ? '/' : currentPath.replace(/^\/ja/, ''))
  : currentPath;
const jaPath = lang === 'en'
  ? (currentPath === '/' ? '/ja/' : `/ja${currentPath}`)
  : currentPath;

const switcherHref = altPath ?? (lang === 'en' ? jaPath : enPath);
const switcherLabel = lang === 'en' ? '日本語' : 'English';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={ogDescription ?? 'Daisuke Nishihama — Astrophysicist & Rocket Engineer'} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {hasTranslation && (
      <>
        <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
        <link rel="alternate" hreflang="ja" href={`${siteUrl}${jaPath}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${enPath}`} />
      </>
    )}
    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription ?? 'Daisuke Nishihama — Astrophysicist & Rocket Engineer'} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Daisuke Nishihama" />
    <meta property="og:locale" content={ogLocale} />
    {hasTranslation && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    {ogType === 'article' && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        <meta property="article:author" content="Daisuke Nishihama" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@daisuke0603N" />
    <meta name="twitter:creator" content="@daisuke0603N" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription ?? 'Daisuke Nishihama — Astrophysicist & Rocket Engineer'} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
    </noscript>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav class="topnav">
      <div class="topnav-inner">
        <a href={homePath} class="topnav-brand">Daisuke Nishihama</a>
        <div class="topnav-links">
          <a href={homePath} class:list={['topnav-link', { active: currentPath === '/' || currentPath === '/ja/' }]}>
            {t('nav.home')}
          </a>
          <a href={achievementsPath} class:list={['topnav-link', { active: currentPath.includes('/achievements') }]}>
            {t('nav.achievements')}
          </a>
          <a href={blogPath} class:list={['topnav-link', { active: currentPath.includes('/blog') }]}>
            {t('nav.blog')}
          </a>
          <a href={web3Path} class:list={['topnav-link', { active: currentPath.includes('/web3') }]}>
            {t('nav.web3')}
          </a>
          <LanguagePicker href={switcherHref} label={switcherLabel} lang={lang === 'en' ? 'ja' : 'en'} />
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Speed up View Transitions page cross-fade (browser default ~0.25s) */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  :root {
    --bg: #FFFFFF;
    --ink: #1A1D21;
    --muted: #6B7178;
    --line: #E7E9EC;
    --link: #1B4A8F;
    --code-bg: #F4F5F7;
    --font-main: 'Lato', 'Noto Sans JP', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;

    /* Single-column shell: section labels hang in a fixed left gutter. */
    --measure: 800px;
    --label-w: 118px;
    --gutter: 1.6rem;
  }

  html {
    font-family: var(--font-main);
    background: var(--bg);
    color: var(--ink);
    font-size: 15px;
    line-height: 1.65;
    -webkit-text-size-adjust: 100%;
    /* Reserve the scrollbar gutter from the first frame. Without it the page paints
       at full viewport width, then the scrollbar appears once the content runs past
       the fold and the centred column jumps ~7.5px left. `scrollbar-gutter` is the
       right tool and works in Firefox, but reserved nothing in the Chrome build this
       was measured on — so keep `overflow-y: scroll` as the fallback underneath it. */
    overflow-y: scroll;
    scrollbar-gutter: stable;
  }

  body { min-height: 100vh; }

  a { color: var(--link); text-decoration: none; }
  a:hover { text-decoration: underline; }

  :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }

  /* ---------- Top nav: a plain text row, no bar ---------- */
  .topnav-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.6rem 2rem 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .topnav-brand {
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .topnav-brand:hover { text-decoration: none; }
  .topnav-links {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1.1rem;
  }
  .topnav-link { color: var(--muted); }
  .topnav-link.active { color: var(--ink); }

  /* ---------- Page shell ---------- */
  .col {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 2.4rem 2rem 4rem;
  }

  /* Identity block on the home page */
  .hero {
    display: flex;
    gap: 1.9rem;
    align-items: center;
    margin-bottom: 2.6rem;
  }
  .hero-avatar {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    flex: none;
    overflow: hidden;
  }
  .hero-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Not a drag handle. `draggable="false"` on the element covers mouse drag;
       these stop the long-press/selection affordances that go with it. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
  }
  .hero-name { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .hero-name-ja { font-size: 0.95rem; color: var(--muted); }
  .hero-role { font-size: 0.92rem; margin-top: 0.3rem; }
  .hero-meta { font-size: 0.82rem; color: var(--muted); margin-top: 0.5rem; }

  /* Title block on the non-home pages */
  .page-head { margin-bottom: 2.6rem; }
  .page-title { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .page-subtitle { font-size: 0.9rem; color: var(--muted); margin-top: 0.3rem; }

  /* Hanging-label sections. Only inside .col-hung; blog pages stay flush. */
  /* The hero and page titles are page-level, not section-level, so they sit on
     the column's left edge — the same margin as the nav brand and the section
     labels — rather than being pushed into the section content column. */

  .section { margin-bottom: 2.4rem; }
  .col-hung .section {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    gap: var(--gutter);
  }
  .section-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .section-body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    min-width: 0;
  }
  /* A hairline above turns these into group boundaries rather than another line
     of body text. The rule is the one piece of ornament this layout keeps, because
     without it the labels sat inside the content column and read as prose. */
  .subsection-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    margin-bottom: -0.5rem;
  }

  .profile-text { font-size: 0.96rem; }

  /* ---------- Entry rows ---------- */
  .entry { display: flex; gap: 1rem; align-items: baseline; }
  .entry-main { flex: 1; min-width: 0; }
  .entry-title { font-weight: 600; font-size: 0.96rem; }
  .entry-org { color: var(--muted); font-size: 0.88rem; }
  .entry-desc { color: var(--muted); font-size: 0.88rem; margin-top: 0.15rem; }
  .entry-date {
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Shared by the profile roles and the certifications list. */
  .plain-list { list-style: none; }
  .plain-item { font-size: 0.92rem; }

  /* ---------- Details block (skills / languages / tags) ---------- */
  .detail-list {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.3rem 1rem;
    font-size: 0.88rem;
  }
  .detail-list dt { color: var(--muted); }
  .detail-list dd { min-width: 0; }

  .tag-list { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag {
    font-size: 0.78rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.1rem 0.45rem;
  }

  /* ---------- Achievements ---------- */
  .ach-entry { display: flex; flex-direction: column; gap: 0.1rem; }
  .ach-meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .ach-type { font-weight: 600; }
  .ach-date { font-variant-numeric: tabular-nums; }
  .ach-item-title { font-weight: 600; font-size: 0.96rem; line-height: 1.45; }
  .ach-authors { font-size: 0.84rem; color: var(--muted); }
  .ach-venue { font-size: 0.88rem; color: var(--muted); }
  .ach-note { font-size: 0.82rem; color: var(--muted); }

  /* ---------- Blog ---------- */
  .blog-list { display: flex; flex-direction: column; }
  .blog-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .blog-item:first-child { padding-top: 0; }
  .blog-item:last-child { border-bottom: none; }
  .blog-item-main { flex: 1; min-width: 0; }
  .blog-item-title { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
  .blog-item-title a { color: var(--ink); }
  .blog-item-desc { font-size: 0.88rem; color: var(--muted); margin-top: 0.2rem; }
  .blog-item-date {
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .blog-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.45rem; }
  .blog-tag {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.05rem 0.4rem;
  }
  .blog-empty { color: var(--muted); padding: 2rem 0; }

  /* ---------- Blog post ---------- */
  .blog-post-back { font-size: 0.85rem; display: inline-block; margin-bottom: 1.5rem; }
  .blog-post-date { font-size: 0.82rem; color: var(--muted); }
  .blog-post-title {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0.3rem 0 0.6rem;
  }
  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .blog-post-content { font-size: 0.96rem; line-height: 1.8; }
  .blog-post-content h2 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2.2rem 0 0.6rem;
  }
  .blog-post-content h3 { font-size: 1.02rem; font-weight: 600; margin: 1.6rem 0 0.4rem; }
  .blog-post-content p { margin-bottom: 1rem; }
  .blog-post-content ul, .blog-post-content ol { margin: 0.75rem 0 1rem 1.5rem; }
  .blog-post-content li { margin-bottom: 0.4rem; }
  .blog-post-content code {
    background: var(--code-bg);
    padding: 0.15em 0.4em;
    border-radius: 2px;
    font-size: 0.88em;
    font-family: var(--font-mono);
  }
  .blog-post-content pre {
    background: var(--code-bg);
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 1rem 1.25rem;
    border-radius: 2px;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .blog-post-content pre code { background: none; padding: 0; font-size: 0.85em; }
  .blog-post-content img { max-width: 100%; height: auto; display: block; margin: 1rem 0; }
  .blog-post-content table { display: block; overflow-x: auto; border-collapse: collapse; margin: 1rem 0; }
  .blog-post-content th, .blog-post-content td {
    border: 1px solid var(--line);
    padding: 0.35rem 0.6rem;
    font-size: 0.9rem;
    text-align: left;
  }
  .blog-post-content blockquote {
    border-left: 2px solid var(--line);
    padding-left: 1rem;
    color: var(--muted);
    margin: 1rem 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .topnav-inner { padding: 1.2rem 1.25rem 0.4rem; flex-wrap: wrap; gap: 0.8rem; }
    .col { padding: 1.8rem 1.25rem 3rem; }
    /* Side by side, the avatar plus its gap ate ~40% of a 390px column and left
       the name/role/meta wrapping onto 5-7 lines. Stacking hands the text the
       full measure; `align-items` has to be reset because the desktop rule
       centres on the cross axis, which becomes horizontal once we go column. */
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
      margin-bottom: 1.8rem;
    }
    .hero-avatar { width: 88px; height: 88px; }
    .col-hung .section { grid-template-columns: 1fr; gap: 0.8rem; }
    .entry { flex-direction: column; gap: 0.1rem; }
    .blog-item { flex-direction: column; gap: 0.1rem; }
    .detail-list { grid-template-columns: 1fr; gap: 0; }
    .detail-list dt { margin-top: 0.5rem; }
    .blog-post-title { font-size: 1.4rem; }
  }
</style>
