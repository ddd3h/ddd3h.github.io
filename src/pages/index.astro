---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import ResumeDetails from '../components/ResumeDetails.astro';
import { useTranslations } from '../i18n/utils';
import { site } from '../data/site';
import { experience, education, projects, committees, certifications } from '../data/resume';

const lang = 'en';
const t = useTranslations(lang);

const technical = experience.filter(e => e.category === 'technical');
const teaching = experience.filter(e => e.category === 'teaching');
---

<BaseLayout lang={lang} currentPath="/" title={t('meta.home.title')} ogDescription={t('meta.home.description')}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Daisuke Nishihama",
    "alternateName": "西濱大将",
    "url": "https://ddd3h.github.io/",
    "sameAs": [
      "https://orcid.org/0009-0007-7716-1290",
      "https://www.researchgate.net/profile/Daisuke-Nishihama-2",
      "https://github.com/ddd3h",
      "https://zenn.dev/ddd3h",
      "https://qiita.com/ddd3h",
      "https://twitter.com/daisuke0603N",
      "https://instagram.com/_ddd3h"
    ],
    "birthPlace": { "@type": "Place", "name": "Soka, Saitama, Japan" },
    "homeLocation": { "@type": "Place", "name": "Osaka, Japan" },
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "ORCID",
      "value": "https://orcid.org/0009-0007-7716-1290"
    },
    "jobTitle": "Ph.D. Student, Astrophysics",
    "worksFor": {
      "@type": "Organization",
      "name": "The University of Osaka"
    }
  })} />

  <div class="col col-hung">
    <ProfileHeader lang={lang} />

    <section class="section">
      <h2 class="section-title">{t('main.profile')}</h2>
      <div class="section-body">
        <ul class="plain-list">
          {site.profileText[lang].map(line => (
            <li class="plain-item">{line}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{t('main.experience')}</h2>
      <div class="section-body">
        <div class="subsection-title">Engineering</div>
        {technical.map(e => (
          <div class="entry">
            <div class="entry-main">
              <div class="entry-title">{e[lang].title}</div>
              <div class="entry-org">{e[lang].org}</div>
              {e[lang].desc && <div class="entry-desc">{e[lang].desc}</div>}
            </div>
            <div class="entry-date">{e.start} – {e.end ?? t('present')}</div>
          </div>
        ))}
        <div class="subsection-title">Teaching</div>
        {teaching.map(e => (
          <div class="entry">
            <div class="entry-main">
              <div class="entry-title">{e[lang].title}</div>
              <div class="entry-org">{e[lang].org}</div>
              {e[lang].desc && <div class="entry-desc">{e[lang].desc}</div>}
            </div>
            <div class="entry-date">{e.start} – {e.end ?? t('present')}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{t('main.education')}</h2>
      <div class="section-body">
        {education.map(e => (
          <div class="entry">
            <div class="entry-main">
              <div class="entry-title">{e[lang].title}</div>
              <div class="entry-org">{e[lang].org}</div>
              {e[lang].desc && <div class="entry-desc">{e[lang].desc}</div>}
            </div>
            <div class="entry-date">{e.start} – {e.end ?? t('present')}</div>
          </div>
        ))}
      </div>
    </section>

    {committees.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('main.committees')}</h2>
        <div class="section-body">
          {committees.map(c => (
            <div class="entry">
              <div class="entry-main">
                <div class="entry-title">{c[lang].role}</div>
                {c[lang].org && <div class="entry-org">{c[lang].org}</div>}
                {c[lang].desc && <div class="entry-desc">{c[lang].desc}</div>}
              </div>
              <div class="entry-date">{c.start} – {c.end ?? t('present')}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {certifications.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('main.certifications')}</h2>
        <div class="section-body">
          <ul class="plain-list">
            {certifications.map(c => (
              <li class="plain-item">{c[lang]}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section">
      <h2 class="section-title">{t('main.extra')}</h2>
      <div class="section-body">
        {projects.map(p => (
          <div class="entry">
            <div class="entry-main">
              <div class="entry-title">{p[lang].title}</div>
              <div class="entry-desc">{p[lang].desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Details</h2>
      <div class="section-body">
        <ResumeDetails lang={lang} />
      </div>
    </section>
  </div>
</BaseLayout>
