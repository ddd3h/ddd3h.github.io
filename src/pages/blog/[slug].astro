---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteUrl = Astro.site.href.replace(/\/$/, '');
const lang = 'en';
const t = useTranslations(lang);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  lang={lang}
  currentPath={`/blog/${post.id}/`}
  title={`${post.data.title} | Daisuke Nishihama`}
  ogImage={`${siteUrl}/og/${post.id}.png`}
  ogDescription={post.data.description}
  ogType="article"
  altPath="/ja/blog/"
  hasTranslation={false}
  publishedTime={post.data.date.toISOString()}
>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    inLanguage: 'en',
    keywords: post.data.tags?.join(', '),
    image: `${siteUrl}/og/${post.id}.png`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}/blog/${post.id}/` },
    author: { '@type': 'Person', name: 'Daisuke Nishihama', url: `${siteUrl}/` },
    publisher: { '@type': 'Person', name: 'Daisuke Nishihama', url: `${siteUrl}/` },
  })} />
  <div class="col">
    <a href="/blog/" class="blog-post-back">{t('blog.back')}</a>
    <div class="blog-post-date">{formatDate(post.data.date)}</div>
    <h1 class="blog-post-title">{post.data.title}</h1>
    {post.data.tags && (
      <div class="blog-post-tags">
        {post.data.tags.map(tag => (
          <span class="blog-tag">{tag}</span>
        ))}
      </div>
    )}
    <div class="blog-post-content">
      <Content />
    </div>
  </div>
</BaseLayout>
