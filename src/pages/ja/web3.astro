---

<BaseLayout lang={lang} currentPath="/ja/web3/" title={t('meta.web3.title')} ogDescription={t('meta.web3.description')}>
  <div class="col col-hung">
    <div class="page-head">
      <h1 class="page-title">{t('finance.title')}</h1>
      <p class="page-subtitle">{t('finance.subtitle')}</p>
    </div>

    <section class="section">
      <h2 class="section-title">{t('finance.gpg')}</h2>
      <div class="section-body">
        <p class="fin-note">{t('finance.gpg.note')}</p>

        <dl class="gpg-meta">
          <dt class="gpg-label">{t('finance.gpg.fingerprint')}</dt>
          <dd><code class="gpg-fingerprint">{gpgKey.fingerprint}</code></dd>
          <dt class="gpg-label">{t('finance.gpg.keyid')}</dt>
          <dd><code class="gpg-value">{gpgKey.keyId}</code></dd>
          <dt class="gpg-label">{t('finance.gpg.algorithm')}</dt>
          <dd><span class="gpg-value">{gpgKey.algorithm} (sign) · {gpgKey.subkeyAlgorithm}</span></dd>
          <dt class="gpg-label">{t('finance.gpg.created')}</dt>
          <dd><span class="gpg-value">{gpgKey.created}</span></dd>
          <dt class="gpg-label">{t('finance.gpg.expires')}</dt>
          <dd><span class="gpg-value">{gpgKey.expires}</span></dd>
        </dl>

        <div class="gpg-key-block">
          <div class="gpg-key-header">
            <span class="gpg-label">{t('finance.gpg.fullkey')}</span>
            <button
              class="copy-btn"
              id="gpg-copy-btn"
              data-key={gpgKey.armoredKey}
              data-copied-text={t('finance.copied')}
            >
              {t('finance.gpg.copykey')}
            </button>
          </div>
          <pre class="gpg-key-pre"><code>{gpgKey.armoredKey}</code></pre>
        </div>

        <p class="gpg-verify-hint">{t('finance.gpg.verify')}</p>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{t('finance.crypto')}</h2>
      <div class="section-body">
        <p class="fin-note">{t('finance.note')}</p>
        <div class="crypto-list">
          {cryptoWithQR.map(chain => (
            <div class="crypto-card">
              <div class="crypto-header">
                <span class="crypto-icon">{chain.icon}</span>
                <span class="crypto-name">{chain.name}</span>
                <span class="crypto-symbol">{chain.symbol}</span>
              </div>
              <div class="crypto-address-row">
                <code class="crypto-address" id={`addr-${chain.id}`}>{chain.address}</code>
                <button
                  class="copy-btn"
                  data-address={chain.address}
                  data-id={chain.id}
                  data-copied-text={t('finance.copied')}
                  aria-label={`${chain.name}のアドレスをコピー`}
                >
                  {t('finance.copy')}
                </button>
                <button
                  class="qr-btn"
                  data-qr-target={`qr-${chain.id}`}
                  aria-label={`${chain.name}のQRコードを表示`}
                >
                  QR
                </button>
              </div>
              <div class="qr-wrap" id={`qr-${chain.id}`} aria-hidden="true">
                <div class="qr-svg" set:html={chain.qrSvg} />
              </div>
              <a href={chain.explorerUrl} target="_blank" rel="noopener" class="explorer-link">
                {t('finance.explorer')} ↗
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const text = el.dataset.address ?? el.dataset.key ?? '';
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = el.dataset.copiedText ?? 'Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  document.querySelectorAll('.qr-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const target = document.getElementById(el.dataset.qrTarget ?? '');
      if (!target) return;
      const open = target.classList.toggle('qr-open');
      target.setAttribute('aria-hidden', open ? 'false' : 'true');
      btn.classList.toggle('qr-active', open);
    });
  });
</script>

<style>
  .fin-note { font-size: 0.88rem; color: var(--muted); }

  .gpg-meta {
    display: grid;
    grid-template-columns: 116px 1fr;
    gap: 0.3rem 1rem;
    font-size: 0.86rem;
  }
  .gpg-label { color: var(--muted); }
  .gpg-fingerprint, .gpg-value {
    font-family: var(--font-mono);
    font-size: 0.88em;
    word-break: break-all;
  }

  .gpg-key-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .gpg-key-pre {
    border: 1px solid var(--line);
    background: var(--code-bg);
    border-radius: 2px;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .gpg-key-pre code { font-family: var(--font-mono); }
  .gpg-verify-hint { font-size: 0.82rem; color: var(--muted); }

  .copy-btn, .qr-btn {
    font: inherit;
    font-size: 0.78rem;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.1rem 0.5rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .copy-btn:hover, .qr-btn:hover { color: var(--ink); border-color: var(--muted); }
  .copy-btn.copied, .qr-btn.qr-active { color: var(--ink); border-color: var(--muted); }

  .crypto-list { display: flex; flex-direction: column; gap: 1.3rem; }
  .crypto-card { display: flex; flex-direction: column; gap: 0.35rem; }
  .crypto-header { display: flex; align-items: baseline; gap: 0.5rem; }
  .crypto-icon { flex: none; }
  .crypto-name { font-weight: 600; font-size: 0.96rem; }
  .crypto-symbol { font-size: 0.82rem; color: var(--muted); }
  .crypto-address-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .crypto-address {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    word-break: break-all;
    flex: 1 1 16rem;
    min-width: 0;
  }
  .qr-wrap { display: none; padding-top: 0.3rem; }
  .qr-wrap.qr-open { display: block; }
  .qr-svg { width: 148px; }
  .qr-svg :global(svg) { width: 100%; height: auto; display: block; }
  .explorer-link { font-size: 0.82rem; }
</style>
