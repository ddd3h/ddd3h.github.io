---
import type { Lang } from '../i18n/utils';

interface Props {
  /** Target path, resolved by BaseLayout so pages can override it. */
  href: string;
  label: string;
  /** Language of the link text, not of the current page. */
  lang: Lang;
}

const { href, label, lang } = Astro.props;
---

<a href={href} class="lang-switcher" lang={lang}>{label}</a>

<style>
  .lang-switcher {
    color: var(--muted);
  }
</style>
